# ==============================================================================
# PortfolioFuture - Financial Intelligence & Market Data Environment Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# DO NOT commit .env containing production secrets to version control.

# Data Provider Configuration
# Set to 'true' to use the offline deterministic mock provider without external HTTP requests.
# Set to 'false' to fetch source-verified market data via Yahoo Finance / live upstream.
USE_MOCK_PROVIDER=false

# Optional Upstream API Credentials (for future external provider expansion)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Local Provenance SQLite Cache Configuration
CACHE_DB_PATH=data/market_cache.sqlite
CACHE_TTL_SECONDS=3600

# API Server Configuration
HOST=0.0.0.0
PORT=8000

# Security & CORS Settings
# In production, restrict this to trusted frontend domains (e.g., https://yourdomain.github.io,http://localhost:8501)
ALLOWED_ORIGINS=*
